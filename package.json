{
  "name": "the-dahan-codex",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "version": "1.0.0",
  "description": "Spirit Island companion app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "generate:public-routes": "node scripts/generate-public-routes.mjs",
    "prerender:public-routes": "node scripts/prerender-public-routes.mjs",
    "build:public": "pnpm generate:public-routes && pnpm build && pnpm prerender:public-routes",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:convex": "convex typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write . && prettier --write \"**/*.{md,mdx,yml,yaml}\"",
    "format:check": "biome format . && prettier --check \"**/*.{md,mdx,yml,yaml}\"",
    "knip": "knip",
    "jscpd": "jscpd .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "biome check . && prettier --check \"**/*.{md,mdx,yml,yaml}\" && pnpm typecheck && pnpm typecheck:convex && pnpm knip && pnpm jscpd",
    "ci": "pnpm check && pnpm build && pnpm test:e2e",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@clerk/react": "^6.12.1",
    "@convex-dev/react-query": "^0.1.0",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@tanstack/query-persist-client-core": "^5.101.2",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.42.1",
    "date-fns": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.23.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-intersection-observer": "^10.0.3",
    "recharts": "^3.9.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/node": "^26.1.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jscpd": "^5.0.12",
    "knip": "^6.26.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.4",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.107.1"
  }
}
